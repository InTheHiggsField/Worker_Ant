<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / device-transfer rules (Android 12+). The Canvas access token is never copied off the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="canvas.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="canvas.xml" />
    </device-transfer>
</data-extraction-rules>
